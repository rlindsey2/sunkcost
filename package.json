{
  "name": "sunkcost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sunk Cost \u2014 how much local-LLM usage it takes for a Mac or DGX Spark to pay for itself.",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && npm run build:og && npm run build:routes && vite build",
    "preview": "vite preview",
    "validate": "tsx scripts/validate-data.ts",
    "build:og": "tsx scripts/build-og.ts",
    "build:routes": "tsx scripts/build-routes.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:single": "npm run build && tsx scripts/build-artifact.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}